{
  "name": "coconut-desktop",
  "productName": "Coconut",
  "version": "0.5.0",
  "private": true,
  "description": "A local-first transcript reader with explicit official CLI subscription connections",
  "author": "Coconut contributors",
  "license": "MIT",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test ../tests/desktop-*.test.mjs",
    "icons:generate": "node ../scripts/generate-app-icons.mjs",
    "icons:check": "node ../scripts/generate-app-icons.mjs --check",
    "package:mac": "node package.mjs --mac",
    "package:dir": "node package.mjs --dir"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.1",
    "@electron/packager": "20.3.0",
    "electron": "44.5.1"
  }
}

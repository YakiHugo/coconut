name: Check Coconut
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
      - name: Python regression and HTTP integration tests
        run: python -m unittest discover -s tests -v
      - name: Install reader test dependencies
        run: npm ci
      - name: Reader regression tests
        run: npm test
      - name: JavaScript syntax
        run: node --check reader/app.js && node --check reader/core.js && node --check reader/jobs.js

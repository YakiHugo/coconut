# pnpm start reads .env. Keep secrets out of Git.
COCONUT_HOST=127.0.0.1
COCONUT_PORT=8080
# Default: ~/.coconut/service. Set an absolute persistent directory to relocate.
# COCONUT_DATA_DIRECTORY=/srv/coconut

# For access through an HTTPS reverse proxy, configure both settings.
# Generate a private token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# COCONUT_PUBLIC_ORIGIN=https://reader.example.com
# COCONUT_OWNER_TOKEN=replace-with-your-generated-token
# Set 0.0.0.0 only when the proxy/container needs a non-loopback listener.

# Leave source-network settings unset to use standard proxy environment settings
# when present, otherwise the normal system route (including transparent TUN).
# COCONUT_SOURCE_NETWORK=direct
# Or: COCONUT_SOURCE_NETWORK=custom
#     COCONUT_SOURCE_PROXY=http://127.0.0.1:7897
# Existing prepared optional Python environments; never installs/downloads models.
# COCONUT_CAPTION_PYTHON=/absolute/path/to/python
# COCONUT_READING_PYTHON=/absolute/path/to/python
# pnpm start runs Python tasks directly, with one Node-owned task queue:
# COCONUT_ASR_PYTHON=/absolute/path/to/prepared/python
# Default local transcription: Qwen3-ASR-1.7B-8bit + ForcedAligner on Apple Silicon.
COCONUT_ASR_BACKEND=qwen-mlx
# COCONUT_MODEL_DIRECTORY=/absolute/path/to/local-mlx-models
# COCONUT_ASR_MODEL=/absolute/path/to/Qwen3-ASR-1.7B-8bit
# COCONUT_ALIGN_MODEL=/absolute/path/to/Qwen3-ForcedAligner-0.6B-8bit
# Configure both local acoustic models to include speaker labels in new transcripts.
# requirements-asr-mlx.txt includes the speaker runtime; weights remain separate.
# COCONUT_SPEAKER_SEGMENTATION_MODEL=/absolute/path/to/segmentation.int8.onnx
# COCONUT_SPEAKER_EMBEDDING_MODEL=/absolute/path/to/speaker.onnx
# Alternative local recipe: MOSS emits native segment times and anonymous speakers.
# COCONUT_ASR_BACKEND=moss-mlx
# Default MOSS model: <COCONUT_MODEL_DIRECTORY or ~/.coconut/models>/MOSS-Transcribe-Diarize-MLX-8bit
# COCONUT_ASR_MODEL=/absolute/path/to/MOSS-Transcribe-Diarize-MLX-8bit
# MOSS ignores Qwen aligner and acoustic-model settings above; no word alignment
# is invented. Speaker IDs are local to each bounded, non-overlapping audio chunk.
# Restart after changing engines; existing jobs keep their original profile.
# See docs/transcription-engines.md for the recipe boundaries and retry behavior.

# Optional post-ASR text review through a locally installed/login-ready CLI.
# Enabling this sends transcript text and episode metadata using that CLI.
# COCONUT_TRANSCRIPT_REVIEW_PROVIDER=codex
# COCONUT_TRANSCRIPT_REVIEW_MODEL=
# Explicit CPU alternative: COCONUT_ASR_BACKEND=faster-whisper (existing small HF cache).
# Missing selected-engine models never trigger an automatic fallback.

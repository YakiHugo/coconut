#!/bin/bash
# pt — one-shot: URL or local file → transcribe → polish → notes
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/.venv/bin/activate"

if [ $# -lt 1 ]; then
    echo "Usage: pt <url-or-file> [output_dir]"
    exit 1
fi

SRC="$1"
OUT_DIR="${2:-$(pwd)}"
mkdir -p "$OUT_DIR"

# Make local paths absolute so we can safely `cd` into OUT_DIR.
if [ -e "$SRC" ]; then
    SRC="$(cd "$(dirname "$SRC")" && pwd)/$(basename "$SRC")"
fi

echo "→ transcribing $SRC"
RAW_PATH=$(cd "$OUT_DIR" && python "$SCRIPT_DIR/transcribe.py" "$SRC" | tail -n1)

if command -v claude >/dev/null 2>&1 || command -v codex >/dev/null 2>&1; then
    echo "→ polishing via local CLI"
    POLISHED_PATH=$(python "$SCRIPT_DIR/polish.py" "$RAW_PATH" | tail -n1)
    echo "→ generating notes"
    python "$SCRIPT_DIR/notes.py" "$POLISHED_PATH"
else
    echo ""
    echo "✓ raw transcript: $RAW_PATH"
    echo "  (install claude or codex CLI for auto-polish + notes, or open it in Claude Code yourself)"
fi

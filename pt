#!/bin/bash
# pt — one-shot: URL → transcribe → polish → markdown
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/.venv/bin/activate"

if [ $# -lt 1 ]; then
    echo "Usage: pt <source> [output_dir] [--polish]"
    exit 1
fi

URL="$1"
OUT_DIR="${2:-$(pwd)}"
mkdir -p "$OUT_DIR"

echo "→ transcribing $URL"
RAW_PATH=$(cd "$OUT_DIR" && python "$SCRIPT_DIR/transcribe.py" "$URL" | tail -n1)

if [ "${3:-}" = "--polish" ]; then
    if [ -z "${ANTHROPIC_API_KEY:-}" ]; then echo "ANTHROPIC_API_KEY is required for requested polishing" >&2; exit 1; fi
    echo "→ polishing with Claude"
    python "$SCRIPT_DIR/polish.py" "$RAW_PATH"
else
    echo ""
    echo "✓ raw transcript: $RAW_PATH"
    echo "  (run polish.py explicitly, or pass --polish as the third argument, to request paid polishing)"
fi
